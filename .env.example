# ── App (Vercel) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
KIE_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed for an ORG key that belongs to several projects, where the call
# would otherwise be ambiguous about which project to bill. A project key
# (sk-proj-…) already carries its project and needs nothing here. Find the id in
# the dashboard URL: /settings/proj_...
# OPENAI_PROJECT_ID=

# Overrides the model for every pipeline stage. Deliberately NOT called
# OPENAI_MODEL — Codex and other agent harnesses export that name with internal
# aliases that the public API rejects, and a shell that had one exported would
# silently retarget every call.
# AD_ASSIST_MODEL=gpt-5.5

# ── Scanner (David's Mac) ─────────────────────────────────────
# Reads scanner/.env first, then falls back to this file, so there is one set of
# Supabase keys on the machine rather than two that drift.
SCANNER_WORKER_ID=davids-mac
SCANNER_CDP_PORT=9333
# SCANNER_POLL_MS=5000
# SCANNER_AD_CEILING=300
# SCANNER_PROFILE=~/.ad-assist/chrome-profile
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
