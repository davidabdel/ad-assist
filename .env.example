# ── App (Vercel) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
KIE_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Only needed when the Anthropic key is ORG-scoped rather than workspace-scoped.
# An org-scoped key is rejected on every endpoint with "not scoped to a
# workspace" unless this header is supplied. A key created inside a workspace
# needs nothing here. Find the id in the Console URL: /settings/workspaces/wrkspc_...
# ANTHROPIC_WORKSPACE_ID=

# Overrides the model for every pipeline stage. Deliberately NOT called
# ANTHROPIC_MODEL — Claude Code and other agent harnesses export that name with
# internal aliases like "opus[1m]" that the public API rejects, and a shell that
# had one exported would silently retarget every call.
# AD_ASSIST_MODEL=claude-opus-5

# ── Scanner (David's Mac) ─────────────────────────────────────
# Reads scanner/.env first, then falls back to this file, so there is one set of
# Supabase keys on the machine rather than two that drift.
SCANNER_WORKER_ID=davids-mac
SCANNER_CDP_PORT=9333
# SCANNER_POLL_MS=5000
# SCANNER_AD_CEILING=300
# SCANNER_PROFILE=~/.ad-assist/chrome-profile
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
